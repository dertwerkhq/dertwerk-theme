{
  "name": "@dertwerk/theme",
  "version": "1.10.0",
  "description": "Palette, light/dark, the appearance control, the branded sign-in screen, the in-app feedback control, and the suite navigation shell, shared by every DertWerk application.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./FeedbackWidget": {
      "types": "./dist/FeedbackWidget.d.ts",
      "default": "./dist/FeedbackWidget.js"
    },
    "./ThemeToggle": {
      "types": "./dist/ThemeToggle.d.ts",
      "default": "./dist/ThemeToggle.js"
    },
    "./BrandedAuthenticator": {
      "types": "./dist/BrandedAuthenticator.d.ts",
      "default": "./dist/BrandedAuthenticator.js"
    },
    "./theme.css": "./dist/theme.css",
    "./themetoggle.css": "./dist/themetoggle.css",
    "./brandedAuthenticator.css": "./dist/brandedAuthenticator.css",
    "./feedback.css": "./dist/feedback.css",
    "./SuiteShell": {
      "types": "./dist/SuiteShell.d.ts",
      "default": "./dist/SuiteShell.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./suite.css": "./dist/suite.css",
    "./navMemory": {
      "types": "./dist/navMemory.d.ts",
      "default": "./dist/navMemory.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-css.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "aws-amplify": ">=6",
    "@aws-amplify/ui-react": ">=6"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "aws-amplify": "^6.20.0",
    "@aws-amplify/ui-react": "^6.15.6"
  }
}
